                },
                "1": {
                  "color": "gray",
                  "text": "IDLE"
                },
                "2": {
                  "color": "orange",
                  "text": "SYNCHRONIZING"
                },
                "3": {
                  "color": "purple",
                  "text": "PROPOSER_CHECK"
                },
